{
  "name": "@krislintigo-zenmoney/zenmoney-client",
  "version": "2.0.1",
  "description": "Modern TypeScript client for the ZenMoney API",
  "keywords": [
    "zenmoney",
    "api",
    "typescript",
    "oauth2",
    "fintech"
  ],
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krislintigo-zenmoney/zenmoney-client.git"
  },
  "license": "MIT",
  "author": "krislintigo",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@krislintigo/prettier-config",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier src --check",
    "format:fix": "prettier src --write",
    "prepare": "husky",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@krislintigo/eslint-config": "^2.1.0",
    "@krislintigo/prettier-config": "^1.0.0",
    "@krislintigo/release-kit": "^1.0.0",
    "@krislintigo/tsconfig": "^1.4.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.1",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
