{
  "name": "@krislintigo-zenmoney/zenmoney-client",
  "version": "1.1.2",
  "description": "Modern TypeScript client for the ZenMoney API",
  "keywords": [
    "zenmoney",
    "api",
    "typescript",
    "oauth2",
    "fintech"
  ],
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krislintigo-zenmoney/zenmoney-client.git"
  },
  "license": "MIT",
  "author": "krislintigo",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "pack:check": "pnpm build && publint",
    "prepublishOnly": "pnpm clean && pnpm lint && pnpm test && pnpm pack:check",
    "release": "semantic-release",
    "release:dry-run": "dotenv -- semantic-release --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "rimraf": "^6.1.3",
    "semantic-release": "^24.2.9",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
