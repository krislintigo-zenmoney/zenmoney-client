{
  "name": "@krislintigo-zenmoney/zenmoney-client",
  "version": "1.2.2",
  "description": "Modern TypeScript client for the ZenMoney API",
  "keywords": [
    "zenmoney",
    "api",
    "typescript",
    "oauth2",
    "fintech"
  ],
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krislintigo-zenmoney/zenmoney-client.git"
  },
  "license": "MIT",
  "author": "krislintigo",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@krislintigo/prettier-config",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "pack:check": "pnpm build && publint",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm pack:check",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@krislintigo/eslint-config": "^2.1.0",
    "@krislintigo/prettier-config": "^1.0.0",
    "@krislintigo/tsconfig": "^1.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.2",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.1",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
